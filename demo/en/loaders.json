{
  "title": "Loading indicator for the app",
  "question": "Which indicator looks better in the interface?",
  "format": "single-elimination",
  "stage": "dark",
  "stage_height": 220,
  "seed": 7,
  "task": "Put the winning indicator into the Spinner component.",
  "css": [
    ".ld{--c:#7dd3fc;--s:56px;position:relative;width:var(--s);height:var(--s);color:var(--c)}",
    ".ring{border:5px solid #ffffff1f;border-top-color:var(--c);border-radius:50%;animation:spin .9s linear infinite}",
    ".dual{border:5px solid transparent;border-top-color:var(--c);border-bottom-color:var(--c);border-radius:50%;animation:spin 1.2s ease-in-out infinite}",
    ".dots{display:flex;gap:9px;align-items:center;justify-content:center;width:auto}.dots i{width:13px;height:13px;border-radius:50%;background:var(--c);animation:bounce 1s ease-in-out infinite}.dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}",
    ".bars{display:flex;gap:6px;align-items:flex-end;width:auto}.bars i{width:8px;height:44px;background:var(--c);border-radius:3px;animation:eq 1s ease-in-out infinite;transform-origin:bottom}.bars i:nth-child(2){animation-delay:.12s}.bars i:nth-child(3){animation-delay:.24s}.bars i:nth-child(4){animation-delay:.36s}.bars i:nth-child(5){animation-delay:.48s}",
    ".pulse::before,.pulse::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--c);opacity:0;animation:ping 1.6s ease-out infinite}.pulse::after{animation-delay:.8s}",
    ".orbit{border-radius:50%;border:2px solid #ffffff1a}.orbit i{position:absolute;inset:0;animation:spin 1.4s linear infinite}.orbit i::before{content:'';position:absolute;top:-6px;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:var(--c)}",
    ".square{width:44px;height:44px;background:var(--c);border-radius:6px;animation:flip 1.4s ease-in-out infinite}",
    ".bar{width:180px;height:6px;border-radius:6px;background:#ffffff1a;overflow:hidden}.bar i{position:absolute;inset:0;width:40%;border-radius:6px;background:var(--c);animation:slide 1.3s ease-in-out infinite}",
    ".grid9{display:grid;grid-template-columns:repeat(3,14px);gap:5px;width:auto;height:auto}.grid9 i{width:14px;height:14px;background:var(--c);border-radius:3px;animation:fade 1.2s ease-in-out infinite}.grid9 i:nth-child(2),.grid9 i:nth-child(4){animation-delay:.15s}.grid9 i:nth-child(3),.grid9 i:nth-child(5),.grid9 i:nth-child(7){animation-delay:.3s}.grid9 i:nth-child(6),.grid9 i:nth-child(8){animation-delay:.45s}.grid9 i:nth-child(9){animation-delay:.6s}",
    ".arc svg{width:100%;height:100%;animation:spin 1.6s linear infinite}.arc circle{fill:none;stroke:var(--c);stroke-width:5;stroke-linecap:round;stroke-dasharray:90 150;animation:dash 1.6s ease-in-out infinite}",
    ".wave{display:flex;gap:4px;align-items:center;width:auto}.wave i{width:5px;height:26px;background:var(--c);border-radius:3px;animation:wave 1.1s ease-in-out infinite}.wave i:nth-child(2){animation-delay:.1s}.wave i:nth-child(3){animation-delay:.2s}.wave i:nth-child(4){animation-delay:.3s}.wave i:nth-child(5){animation-delay:.4s}.wave i:nth-child(6){animation-delay:.5s}.wave i:nth-child(7){animation-delay:.6s}",
    ".typing{font:600 30px ui-monospace,Menlo,monospace;width:auto;height:auto;letter-spacing:.06em}.typing span{animation:fade 1.2s steps(1) infinite}.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}",
    "@keyframes spin{to{transform:rotate(360deg)}}",
    "@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:.5}40%{transform:translateY(-14px);opacity:1}}",
    "@keyframes eq{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}",
    "@keyframes ping{0%{transform:scale(.2);opacity:.9}100%{transform:scale(1.2);opacity:0}}",
    "@keyframes flip{0%{transform:perspective(200px) rotateX(0) rotateY(0)}50%{transform:perspective(200px) rotateX(180deg) rotateY(0)}100%{transform:perspective(200px) rotateX(180deg) rotateY(180deg)}}",
    "@keyframes slide{0%{left:-40%}100%{left:100%}}",
    "@keyframes fade{0%,100%{opacity:.2}50%{opacity:1}}",
    "@keyframes dash{0%{stroke-dasharray:10 230}50%{stroke-dasharray:120 120}100%{stroke-dasharray:10 230}}",
    "@keyframes wave{0%,100%{transform:scaleY(.35)}50%{transform:scaleY(1)}}"
  ],
